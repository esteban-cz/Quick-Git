{
  "name": "quick-git",
  "displayName": "Quick Git",
  "description": "Clone, pull, push, and commit from the VS Code status bar and Command Palette, with repository selection and staged-only commits.",
  "version": "3.1.0",
  "publisher": "esty",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "icon/Quick-Git-logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/esteban-cz/Quick-Git"
  },
  "contributes": {
    "menus": {
      "editor/title": [
        {
          "command": "quickGit.Pull",
          "group": "navigation",
          "when": "gitOpenRepositoryCount > 0"
        },
        {
          "command": "quickGit.Commit&Push",
          "group": "navigation",
          "when": "gitOpenRepositoryCount > 0"
        }
      ]
    },
    "commands": [
      {
        "command": "quickGit.showGitMenu",
        "title": "Quick Git: Open Actions"
      },
      {
        "command": "quickGit.Clone",
        "title": "Quick Git: Clone Repository"
      },
      {
        "command": "quickGit.Pull",
        "title": "Quick Git: Pull",
        "icon": "$(git-fetch)"
      },
      {
        "command": "quickGit.Push",
        "title": "Quick Git: Push"
      },
      {
        "command": "quickGit.Commit",
        "title": "Quick Git: Commit"
      },
      {
        "command": "quickGit.Commit&Push",
        "title": "Quick Git: Commit & Push",
        "icon": "$(git-commit)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Quick Git",
      "properties": {
        "quickGit.commitMessageOption": {
          "type": "string",
          "enum": [
            "Default",
            "Custom"
          ],
          "default": "Default",
          "description": "Use the saved commit message or prompt for a message each time.",
          "scope": "resource"
        },
        "quickGit.defaultCommitMessage": {
          "type": "string",
          "default": "New",
          "description": "Commit message used when the message option is Default.",
          "scope": "resource"
        },
        "quickGit.commitScope": {
          "type": "string",
          "enum": [
            "all",
            "staged"
          ],
          "enumDescriptions": [
            "Stage and commit all changes in the selected repository.",
            "Commit only changes already staged in Source Control."
          ],
          "default": "all",
          "description": "Choose which changes Quick Git commits.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "vscode:package": "vsce package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "npm run compile && npm run lint",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "@types/vscode": "1.96.0",
    "@typescript-eslint/parser": "8.74.0",
    "@vscode/vsce": "4.0.0",
    "eslint": "10.15.0",
    "typescript": "6.0.3"
  },
  "license": "MIT",
  "extensionDependencies": [
    "vscode.git"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Quick Git works with repositories opened by VS Code\u2019s built-in Git extension."
    }
  }
}
